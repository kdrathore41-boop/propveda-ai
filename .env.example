# PropVeda AI runtime configuration
PORT=10000
# Set this to the exact frontend origin in production. Keep * only for controlled development.
CORS_ORIGIN=*

# Public lead inbox protection: use a long, random secret and never expose it in frontend source.
LEAD_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional Meta WhatsApp Cloud API delivery. Notifications stay pending until every required value is configured.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=91XXXXXXXXXX
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=propveda_new_lead
WHATSAPP_TEMPLATE_LANGUAGE=en_US
